# Runtime persistence mode.
# - postgres (default): production runtime source of truth
# - file-legacy: development-only fallback for local legacy testing
PERSISTENCE_MODE=postgres

# Runtime PostgreSQL URL (required unless PERSISTENCE_MODE=file-legacy).
# Railway production backend variable:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Local .env files must use a fully resolved PostgreSQL URL instead of Railway
# variable-reference syntax.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ponotai_dev?schema=public

# Optional override for legacy file-mode path
PONOTAI_DATA_DIR=backend/data

# Runtime
NODE_ENV=development
PORT=4000

# Auth
JWT_SECRET=dev-secret-change-me
ADMIN_EMAIL=owner@example.com
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

AUTH_BYPASS_EMAIL_VERIFICATION=true

# Railway production backend checklist:
# NODE_ENV=production
# PERSISTENCE_MODE=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_SECRET=<strong-production-secret>
# ALLOWED_ORIGINS=https://<frontend-domain>
# CORS_ORIGINS=https://<frontend-domain>
# FRONTEND_URL=https://<frontend-domain>
# FRONTEND_URLS=https://<frontend-domain>
# AUTH_BYPASS_EMAIL_VERIFICATION=false
#
# If AUTH_BYPASS_EMAIL_VERIFICATION=false, configure the mailer variables below.
# Railway interpolation syntax (${{...}}) is Railway-only. Do not use it locally.

# Provider 1 (fast path): AuDD
AUDD_API_KEY=
AUDD_API_TOKEN=
AUDD_API_URL=https://api.audd.io/

# AI Assistant
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Email verification delivery (required in production when bypass is false)
MAILER_API_URL=
MAILER_API_TOKEN=
MAILER_FROM=no-reply@example.com

# Optional for YouTube verification lookup
YOUTUBE_API_KEY=

# Optional for fallback LLM verification of noisy audio matches
HUGGINGFACE_API_KEY=
HUGGINGFACE_VISION_URL=https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Provider 2 (broad catalog fallback): ACRCloud
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_API_KEY=

# Provider 3 (degraded/noisy audio fallback): Shazam community package
SHAZAM_MOCK_RESPONSE=

# Optional recognition debug logging
RECOGNITION_DEBUG=false
