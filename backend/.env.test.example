# Backend test database. Use a separate disposable database only.
# Never point TEST_DATABASE_URL or DATABASE_URL at production or shared staging data.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ponotai_test?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ponotai_test?schema=public

# The backend test harness maps TEST_DATABASE_URL to DATABASE_URL in NODE_ENV=test.
TEST_PERSISTENCE_MODE=postgres
AUTH_BYPASS_EMAIL_VERIFICATION=true
JWT_SECRET=test-secret

# Optional local test database helper from repo root:
# docker compose -f docker-compose.test.yml up -d
