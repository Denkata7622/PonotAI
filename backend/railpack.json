{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "python": "3"
  },
  "install": {
    "commands": [
      "npm ci"
    ]
  },
  "build": {
    "commands": [
      "npm run build"
    ]
  },
  "buildAptPackages": [
    "ffmpeg"
  ],
  "deploy": {
    "aptPackages": [
      "ffmpeg"
    ]
  }
}
