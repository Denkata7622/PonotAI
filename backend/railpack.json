{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "python": "3"
  },
  "install": {
    "commands": [
      "npm ci",
      "python3 -m pip install --upgrade pip",
      "rm -rf .python_packages",
      "python3 -m pip install --target .python_packages -r requirements.txt"
    ]
  },
  "build": {
    "commands": [
      "npm run build"
    ]
  },
  "buildAptPackages": ["ffmpeg"],
  "deploy": {
    "aptPackages": ["ffmpeg"]
  }
}
