# Frontend local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_BYPASS_EMAIL_VERIFICATION=false

# Optional runtime-only fallback for server-side frontend routes.
TRACKLY_API_BASE_URL=http://localhost:4000

# YouTube resolve/search API routes.
YOUTUBE_API_KEY=

# Local ZIP downloader route (/api/download). Leave unset when tools are on PATH.
# Windows/macOS/Linux local installs are checked by `npm run doctor:download`.
# Railway with frontend/Dockerfile:
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_LOCATION=/usr/bin
YTDLP_TIMEOUT_MS=180000
YTDLP_CACHE_DISABLED=false
# YTDLP_CACHE_DIR=
# YTDLP_COOKIES=
# YTDLP_SLEEP_INTERVAL=
# YTDLP_MAX_SLEEP_INTERVAL=

