# Public URL of the backend API used by the frontend in production.
# Keep this aligned with backend ALLOWED_ORIGINS/CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=https://trackly-api.up.railway.app
NEXT_PUBLIC_AUTH_BYPASS_EMAIL_VERIFICATION=false

# Required by frontend server routes that resolve playable YouTube IDs.
# Must be available at runtime for /api/youtube/resolve and /api/search.
YOUTUBE_API_KEY=
