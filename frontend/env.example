# Public URL of the backend API used by the frontend.
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
#
# Railway frontend service:
# NEXT_PUBLIC_API_BASE_URL=https://<backend-public-domain>
#
# This variable belongs on the frontend service and is embedded at build time.
# Rebuild/redeploy the frontend after changing NEXT_PUBLIC_* values.
# Keep the frontend public domain listed in backend ALLOWED_ORIGINS/CORS_ORIGINS.
NEXT_PUBLIC_AUTH_BYPASS_EMAIL_VERIFICATION=false

# Required by frontend server routes that resolve playable YouTube IDs.
# Must be available at runtime for /api/youtube/resolve and /api/search.
YOUTUBE_API_KEY=

# Local ZIP downloader route (/api/download) runs in the frontend service.
# Railway frontend service values when using frontend/Dockerfile:
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_LOCATION=/usr/bin
